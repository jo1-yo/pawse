# Trimmed from the upload. Note this does NOT affect service detection — the
# CLI scans the local working tree before uploading — so the `services` key in
# vercel.json is what actually keeps server/ from being built here. This file's
# real job is keeping server/.env, which holds the live API key, off Vercel.
server/
extension/
docs/

# Build artifacts and local caches; Vercel produces dist/ itself.
dist/
.expo/
