{
  "manifest_version": 3,
  "name": "Pawse",
  "version": "0.2.0",
  "description": "Drop in your classes and deadlines. Pawse builds a balanced week and exports it to your calendar.",
  "action": { "default_title": "Pawse" },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel", "clipboardRead"],
  "host_permissions": ["https://pawse-server.onrender.com/*"],
  "icons": { "128": "icon-128.png" }
}
