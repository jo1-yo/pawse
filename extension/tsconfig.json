{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["../src/*"],
      "expo-localization": ["src/shims/expo-localization.ts"],
      "expo-file-system": ["src/shims/expo-file-system.ts"],
      "expo-sharing": ["src/shims/expo-sharing.ts"]
    },
    "types": ["chrome", "vite/client"]
  },
  "include": ["src", "vite.config.ts"]
}
