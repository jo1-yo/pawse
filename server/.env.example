# Pawse backend — copy to `.env` and fill in.

# Your fal.ai key (same kind you use in Martini). This is the ONLY secret;
# it stays on the server and never ships in the app.
FAL_KEY=

# Port the server listens on (default 8787).
PORT=8787

# Optional model overrides (defaults are the proven any-llm ids):
# PLAN_MODEL=anthropic/claude-3.5-sonnet
# VISION_MODEL=google/gemini-2.0-flash-001

# Where in-app "Send feedback" goes. FREE option: a Discord (or Slack) incoming
# webhook URL — you'll get a phone notification per message at $0. Leave blank
# to just log feedback to the server. (Point at Productlane/Zapier later.)
# FEEDBACK_WEBHOOK_URL=https://discord.com/api/webhooks/XXXX/YYYY
