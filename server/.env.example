# Pawse backend — copy to `.env` and fill in. The server loads `.env` on boot
# (shell env vars win over the file).

# Preferred for timetable-photo reading: your own OpenAI key (gpt-4o-mini does
# vision + strict JSON in one call, ~$0.0005 per photo). Create the key at
# https://platform.openai.com/api-keys after adding the $5 minimum credit
# under Settings -> Billing. Secrets stay on the server, never in the app.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Fallback when OPENAI_API_KEY is empty: fal.ai key (same kind as Martini).
FAL_KEY=

# Port the server listens on (default 8787).
PORT=8787

# Optional model overrides (defaults are the proven any-llm ids):
# PLAN_MODEL=anthropic/claude-3.5-sonnet
# VISION_MODEL=google/gemini-2.0-flash-001

# Where in-app "Send feedback" goes. Recommended: deploy the Google Apps Script
# in ./google-apps-script so every message is appended to a private Google Doc.
# Discord and Slack incoming webhooks remain compatible. Leave blank to log the
# structured message to the server instead.
# FEEDBACK_WEBHOOK_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
# Shared secret checked by the Google Apps Script receiver. Use a long random
# value and set the same PAWSE_FEEDBACK_SECRET in Apps Script properties.
# FEEDBACK_WEBHOOK_SECRET=
