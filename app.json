{
  "expo": {
    "name": "Pawse",
    "slug": "pawse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/pawse-icon.png",
    "scheme": "pawse",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#ffffff",
    "ios": {
      "bundleIdentifier": "film.martini.pawse",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "NSCalendarsFullAccessUsageDescription": "Pawse adds your classes, study blocks, and deadlines to your calendar so your whole week is in one place.",
        "NSCalendarsWriteOnlyAccessUsageDescription": "Pawse adds your study schedule and deadlines to your calendar.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "film.martini.pawse",
      "adaptiveIcon": {
        "backgroundColor": "#ffd1dc",
        "foregroundImage": "./assets/images/pawse-splash.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0a0f",
          "image": "./assets/images/pawse-splash.png",
          "imageWidth": 180,
          "android": {
            "backgroundColor": "#0a0a0f",
            "image": "./assets/images/pawse-splash.png",
            "imageWidth": 160
          }
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Pawse adds your classes, study blocks, and deadlines to your calendar."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pawse reads your class timetable photo to build your schedule.",
          "cameraPermission": "Pawse can snap a photo of your timetable to build your schedule."
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "backendUrl": "http://localhost:8787",
      "google": {
        "webClientId": "",
        "iosClientId": "",
        "androidClientId": ""
      }
    }
  }
}
